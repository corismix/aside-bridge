{
  "name": "@aside-miniapp/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && concurrently -n tsc,node -c gray,cyan \"tsc -p tsconfig.json -w --preserveWatchOutput\" \"node --watch --watch-path=dist dist/index.js\"",
    "build": "tsc -p tsconfig.json && cp src/cloudflared-release.json src/mobile-policy.json dist/",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "pair": "node dist/pair.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.2",
    "@telegram-apps/init-data-node": "^2.0.10",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
